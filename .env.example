# Copy to .env and fill in. `npm start` and the launchd service both load it.
# Keep it out of version control: it is gitignored, and it holds your token.

# ===========================================================================
# Required
# ===========================================================================

# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to talk to the bot. There is no
# default: the bridge refuses to start without this, rather than booting with
# an allowlist you did not choose. Message @userinfobot to find your ID.
ALLOWED_TELEGRAM_USERS=

# ===========================================================================
# Core
# ===========================================================================

# Comma-separated group/supergroup IDs the bot will respond in. A user must
# ALSO be in ALLOWED_TELEGRAM_USERS. Leave empty for direct messages only.
ALLOWED_TELEGRAM_GROUPS=

# Working directory for every Claude session. Put your CLAUDE.md here: it is
# what gives the bot its identity, and its .claude/ directory supplies skills
# and MCP servers. See CLAUDE.md.example for a starting point.
CLAUDE_CWD=

# Shown in /start and /help. The actual persona comes from CLAUDE.md.
ASSISTANT_NAME=Claude

# Default chat for heartbeat output, API dispatches with no chat_id, and
# sensitive-content redirects. Defaults to the first allowed user.
# DEFAULT_CHAT_ID=

# Optional friendly names for chats, shown in the control API.
# CHAT_NAMES={"-1001234567890":"family","-1009876543210":"work"}

# LOG_DIR=~/.claude-telegram-bridge/logs
# DOWNLOAD_DIR=~/.claude-telegram-bridge/downloads
# Sessions, per-chat pins, and the quiet-hours alert queue.
# STATE_DIR=~/.claude-telegram-bridge

# Claude Code uses your existing Claude login or ANTHROPIC_API_KEY.
# ANTHROPIC_API_KEY=

# ===========================================================================
# Time
# ===========================================================================

# IANA name. Every schedule and quiet-hours check uses this, not the host's
# local zone. Default UTC.
BRIDGE_TIMEZONE=UTC

# Nothing non-urgent goes out in this window. Cron alerts and output bound for
# DEFAULT_CHAT_ID queue up and flush 5 minutes after QUIET_HOURS_END.
QUIET_HOURS_START=23
QUIET_HOURS_END=8

# ===========================================================================
# Models
# ===========================================================================

# Tier names are the vocabulary for /model, for a subagent's `model:`
# frontmatter, and for a cron job's `model` field. Override the ids so those
# names keep working across model releases.
FABLE_MODEL_ID=claude-fable-5
SONNET_MODEL_ID=claude-sonnet-4-5
HAIKU_MODEL_ID=claude-haiku-4-5

# Tier used when nothing is pinned.
DEFAULT_MODEL_TIER=sonnet

# Kill switch. Routes ALL traffic to one model, ignoring every pin. Set it,
# restart, and you have rolled back without touching code.
# ANTHROPIC_MODEL_FORCE=claude-sonnet-4-5

# ===========================================================================
# Cron jobs (optional)
# ===========================================================================

# A module default-exporting an array of jobs. Nothing is scheduled without
# it. Start from cron-jobs.example.mjs.
# CRON_JOBS_FILE=./cron-jobs.local.mjs

# Where a job's failure alert goes when the job itself is silent.
# CRON_ERROR_CHAT=

# Ceiling on what one job may spend before the SDK stops it. Default 5.
# CRON_MAX_BUDGET_USD=5

# Optional custom extensions module exporting a register({ bot, config, log, auditLog, sendLongMessage }) function.
# Use this to attach custom Telegram event listeners (e.g. callback_query) without editing bridge code.
# EXTENSIONS_FILE=./extensions.local.mjs

# ===========================================================================
# Heartbeat (optional)
# ===========================================================================

# A periodic self-directed check-in: "anything I should know about?" running
# on a timer. Disabled unless this points at a file describing what to check.
# The bridge appends the reporting contract, including the HEARTBEAT_OK reply
# that keeps a quiet run silent.
# HEARTBEAT_PROMPT_FILE=./heartbeat.md

# HEARTBEAT_INTERVAL_MS=1800000
# HEARTBEAT_DELIVERY_CHAT=
# HEARTBEAT_MODEL=haiku

# Cost control. When HEARTBEAT_PROBE_URL is set, each tick hashes that
# endpoint and skips the model entirely while the response is unchanged,
# until HEARTBEAT_FULL_INTERVAL_MS forces a run anyway.
# Point it at anything cheap that changes when your world does: a task
# tracker's unread count, a CI status endpoint, your own JSON file over HTTP.
# HEARTBEAT_PROBE_URL=
# HEARTBEAT_PROBE_HEADER=Authorization: Bearer your-token
# HEARTBEAT_FULL_INTERVAL_MS=7200000

# ===========================================================================
# Control API (optional)
# ===========================================================================

# Binds to 127.0.0.1 only. Without a key, every /api/* route returns 401;
# an empty key never means "open". /livez stays open for the watchdog.
# BRIDGE_API_KEY=
# API_PORT=8091
# Browser access is off by default: no CORS headers are sent at all. Set this
# to your dashboard's origin only if you need it.
# API_CORS_ORIGIN=https://localhost:3000

# ===========================================================================
# Sensitive-content guard (optional)
# ===========================================================================

# Comma-separated words. An outbound message matching one on a word boundary
# is redirected to SENSITIVE_REDIRECT_CHAT instead of the group it was headed
# for. Pick specific words: a common one will redirect messages you wanted in
# the group.
# SENSITIVE_KEYWORDS=
# SENSITIVE_REDIRECT_CHAT=

# ===========================================================================
# Voice transcription (optional)
# ===========================================================================

# Voice notes are transcribed locally, so audio never leaves the host. Without
# these, a voice message is handed to Claude as a file instead.
# Bare names resolve through PATH; use absolute paths under launchd/systemd.
# FFMPEG_PATH=ffmpeg
# WHISPER_PATH=whisper
# WHISPER_MODEL=tiny
# WHISPER_LANGUAGE=en

# Prepended to PATH for those binaries. Service managers give a process a
# minimal PATH, so a Homebrew install is otherwise invisible.
# EXTRA_PATH=/opt/homebrew/bin

# ===========================================================================
# Watchdog script (optional; see scripts/bridge-watchdog.sh)
# ===========================================================================

# The watchdog reads API_PORT above to build its /livez URL.
# WATCHDOG_ALERT_CHAT=
# BRIDGE_LABEL=com.claude-telegram-bridge
# Alert if a specific cron job stops firing. Unset = check skipped.
# WATCHDOG_CRON_JOB=
# WATCHDOG_CRON_STALE_SECS=129600

# ===========================================================================
# Resilience tuning (all optional; defaults shown)
# ===========================================================================

# Max concurrent Claude SDK subprocesses (each holds ~300 MB).
# MAX_CONCURRENT_QUERIES=3
# Wall-clock cap on a single interactive query.
# RUNCLAUDE_TIMEOUT_MS=1800000
# Agent turn cap per interactive query.
# MAX_TURNS=100
# Unhandled-rejection storm threshold before a clean restart (per 5 min).
# UNHANDLED_REJECTION_EXIT_THRESHOLD=10
# Polling staleness threshold (3x during quiet hours).
# POLLING_STALE_MS=1800000
# GETME_PROBE_INTERVAL_MS=300000

# The remaining watchdogs. Each of these decides when the bridge exits(1) and
# lets the service manager restart it, so raise them if you see spurious
# restarts and lower them if a wedge takes too long to clear.
# Consecutive network-class polling errors before a clean restart.
# POLLING_NETWORK_ERROR_EXIT_THRESHOLD=10
# How often to probe Telegram for undrained updates.
# PENDING_PROBE_INTERVAL_MS=300000
# Grace period after a suppressed EPIPE before the process is called a zombie.
# Defaults to 2 probe cycles + 60s, so it moves with PENDING_PROBE_INTERVAL_MS
# unless you set it explicitly. Keep it above 2 cycles: one missed probe must
# not be enough to trigger it.
# ZOMBIE_EPIPE_WATCHDOG_MS=660000

# Agent SDK stream watchdog: on by default, kills wedged SSE streams.
# API_TIMEOUT_MS is deliberately NOT defaulted: set it only if you want a hard
# per-request cap, since long reasoning turns can legitimately stream for many
# minutes.
# CLAUDE_ENABLE_STREAM_WATCHDOG=1
# CLAUDE_STREAM_IDLE_TIMEOUT_MS=600000
# API_TIMEOUT_MS=
# CLAUDE_CODE_MAX_RETRIES=3

# Directory holding subagent definitions (*.md with YAML frontmatter).
# AGENTS_DIR=~/.claude/agents
