{
  "name": "claude-code-telegram-bridge",
  "version": "1.0.0",
  "description": "Run Claude Code as a Telegram bot: full CLI parity, scheduled jobs, and production resilience",
  "type": "module",
  "main": "bridge.mjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoquem/claude-code-telegram-bridge.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "telegram",
    "telegram-bot",
    "anthropic",
    "agent",
    "ai-assistant"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "init": "node setup-wizard.mjs",
    "start": "node --env-file-if-exists=.env bridge.mjs",
    "dev": "node --env-file-if-exists=.env --watch bridge.mjs",
    "test": "node --import ./tests/setup.mjs --test tests/*.test.mjs",
    "test:wizard": "node tests/wizard-e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.207",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0"
  }
}
